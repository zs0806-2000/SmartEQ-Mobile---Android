<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose draws the real theme (ui/theme/Theme.kt). This only colours the window
         before the first frame, matching the phone's light/dark setting. -->
    <style name="Theme.SmartEQPro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="Theme.SmartEQPro.Splash" parent="Theme.SmartEQPro" />
</resources>
