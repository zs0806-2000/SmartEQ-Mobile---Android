<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of backup_rules.xml, covering both cloud backup
  and device-to-device transfer. Same exclusions, same reasoning: no
  secrets ever leave this device via either path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="app_lock_prefs.xml" />
        <exclude domain="database" path="smarteq_presets.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="app_lock_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
